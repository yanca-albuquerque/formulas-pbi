Html_Bloco_Eqpto = 
/* --- 1. CAPTURA DOS DADOS --- */
VAR vLink_Eqpto  = SELECTEDVALUE('Base'[Link Eqptos], "https://google.com")
VAR vID          = SELECTEDVALUE('Base'[id_eqpto], "-")
VAR vNome        = SELECTEDVALUE('Base'[nome_eqpto], "-")
VAR vTipo        = SELECTEDVALUE('Base'[eqpto_tipo], "-")
VAR vIP          = SELECTEDVALUE('Base'[ip_eqpto], "-")
VAR vSNMP        = SELECTEDVALUE('Base'[snmp_comm_read], "-")
VAR vStatus      = SELECTEDVALUE('Base'[eqpto_status], "-")
VAR vErros       = SELECTEDVALUE('Cenários'[qtd_erros_total_geral], "-")

/* --- LÓGICA DO POP-UP (0/1) --- */
VAR vPopupNum = SELECTEDVALUE('Base'[f_tem_nat], 1) 
/* VAR vPopupTexto = IF(vPopupNum = 1, "Sim", "Não") */ /* colocar la no final do css se for usar sim/nao: " & vPopupTexto & " */
VAR vPopupIcon  = IF(vPopupNum = 1, "●", "✖")
VAR vPopupColor = IF(vPopupNum = 1, "#28a745", "#dc3545")

/* --- PORCENTAGEM --- */
VAR vAcertosRaw  = SELECTEDVALUE('Cenários'[perc_acertos_total_geral])
VAR vAcertos     = IF(ISBLANK(vAcertosRaw), "-", FORMAT(vAcertosRaw, "0%"))

VAR vCorPrincipal = "#E3262E"
VAR vClasseStatus = IF(vStatus = "Ativado", "status-ok", "status-erro")

RETURN
"
<style>
    /* Estilo do Container Principal */
    .header-container {
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        justify-content: space-between; 
        align-items: center;
        background-color: #ffffff;
        border-radius: 8px;
        padding: 10px 18px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-left: 6px solid " & vCorPrincipal & ";
    }

    /* Estilo padrão (Alinhado a Esquerda) */
    .info-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    /* MUDANÇA AQUI: Nova classe para centralizar itens específicos */
    .center-item {
        align-items: center; /* Centraliza horizontalmente */
        text-align: center;
    }

    .label {
        font-size: 10px;
        text-transform: uppercase;
        color: #888;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .value {
        font-size: 14px;
        font-weight: bold;
        color: #333;
        white-space: nowrap; 
    }

    /* Links e Cores */
    .link-style { text-decoration: none; color: " & vCorPrincipal & "; cursor: pointer; pointer-events: auto; }
    .link-style:hover { text-decoration: underline; }

    .status-ok { color: #28a745; background-color: #e6f9e9; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
    .status-erro { color: #dc3545; background-color: #fbeaea; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
</style>

<div class='header-container'>
  
  <div class='info-item'>
    <span class='label'>ID</span>
    <span class='value'>" & vID & "</span>
  </div>

  <div class='info-item'>
    <span class='label'>Equipamento</span>
    <span class='value'>
        <a href='" & vLink_Eqpto & "' target='_blank' class='link-style'>" & vNome & "</a>
    </span>
  </div>

  <div class='info-item'>
    <span class='label'>Tipo</span>
    <span class='value'>" & vTipo & "</span>
  </div>

  <div class='info-item'>
    <span class='label'>IP</span>
    <span class='value'>" & vIP & "</span>
  </div>

  <div class='info-item'>
    <span class='label'>SNMP</span>
    <span class='value'>" & vSNMP & "</span>
  </div>

  <div class='info-item'>
    <span class='label'>Status</span>
    <div><span class='value " & vClasseStatus & "'>" & vStatus & "</span></div>
  </div>

  <div class='info-item center-item'>
    <span class='label'>Pop-Up</span>
    <span class='value' style='color:" & vPopupColor & "'>
        " & vPopupIcon & " 
    </span>
  </div>

  <div class='info-item center-item'>
    <span class='label'>Erros</span>
    <span class='value'>
        <span style='color:#dc3545;'>" & vErros & "</span>
    </span>
  </div>
  
  <div class='info-item center-item'>
    <span class='label'>Acertos</span>
    <span class='value'>
        <span style='color:#28a745;'>" & vAcertos & "</span>
    </span>
  </div>

</div>
"
