Html_Bloco_Titulo = 
/* --- 1. CAPTURA DOS DADOS (SEM TRAVAS) --- */
VAR v1    = SELECTEDVALUE('Base'[1], "https://google.com")
VAR v2    = SELECTEDVALUE('Base'[2], "-")
VAR v3    = SELECTEDVALUE('Base'[3], "-")
VAR v4    = SELECTEDVALUE('Base'[4], "-")
VAR vStatus    = SELECTEDVALUE('Base'[Status], "-")

/* --- LÓGICA DE ICONES (0/1) --- */
VAR vIconesNum = SELECTEDVALUE('Base'[icones], 1) 
VAR vIconesIcon  = IF(vIconesNum = 1, "●", "✖")
VAR vIconesColor = IF(vIconesNum = 1, "#28a745", "#dc3545")

/* --- PORCENTAGEM --- */
VAR vPorcentoRaw  = SELECTEDVALUE('Medidas'[perc_total])
VAR vPorcento     = IF(ISBLANK(vPorcentoRaw), "-", FORMAT(vPorcentoRaw, "0%"))

VAR vCorPrincipal = "#B3B3B3"
VAR vClasseStatus = IF(vStatus = "Ativo", "Desativado", "Pendente") 

RETURN
"
<style>
    /* Estilo do Container Principal */
    .NOME1 {
        font-family: 'Segoe UI', sans-serif;
        display: flex;
        justify-content: space-between; 
        align-items: center;
        background-color: #ffffff;
        border-radius: 8px;
        padding: 10px 18px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        border-left: 6px solid " & vCorPrincipal & ";
    }

    /* Estilo padrão (Alinhado a Esquerda) */
    .NOME2 {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    /* Nova classe para centralizar itens específicos */
    .NOME3 {
        align-items: center; 
        text-align: center;
    }

    .NOME4 {
        font-size: 10px;
        text-transform: uppercase;
        color: #888;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .NOME5 {
        font-size: 14px;
        font-weight: bold;
        color: #333;
        white-space: nowrap; 
    }

    /* Links e Cores */
    .NOME8 { text-decoration: none; color: " & vCorPrincipal & "; cursor: pointer; pointer-events: auto; }
    .NOME8:hover { text-decoration: underline; }

    .NOME6 { color: #28a745; background-color: #e6f9e9; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
    .NOME7 { color: #dc3545; background-color: #fbeaea; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
</style>

<div class='NOME1'>
  
  <div class='NOME2'>
    <span class='NOME4'>ID</span>
    <span class='NOME5'>" & vID & "</span>
  </div>

  <div class='NOME2'>
    <span class='NOME4'>Equipamento</span>
    <span class='NOME5'>
        <a href='" & vLink_Eqpto & "' target='_blank' class='NOME8'>" & vNome & "</a>
    </span>
  </div>

  <div class='NOME2'>
    <span class='NOME4'>Tipo</span>
    <span class='NOME5'>" & vTipo & "</span>
  </div>

  <div class='NOME2'>
    <span class='NOME4'>IP</span>
    <span class='NOME5'>" & vIP & "</span>
  </div>

  <div class='NOME2'>
    <span class='NOME4'>SNMP</span>
    <span class='NOME5'>" & vSNMP & "</span>
  </div>

  <div class='NOME2'>
    <span class='NOME4'>Status</span>
    <div><span class='NOME5 " & vClasseStatus & "'>" & vStatus & "</span></div>
  </div>

  <div class='NOME2 NOME3'>
    <span class='NOME4'>Pop-Up</span>
    <span class='NOME5' style='color:" & vPopupColor & "'>
        " & vPopupIcon & " 
    </span>
  </div>

  <div class='NOME2 NOME3'>
    <span class='NOME4'>Erros</span>
    <span class='NOME5'>
        <span style='color:#dc3545;'>" & vErros & "</span>
    </span>
  </div>
  
  <div class='NOME2 NOME3'>
    <span class='NOME4'>Acertos</span>
    <span class='NOME5'>
        <span style='color:#28a745;'>" & vAcertos & "</span>
    </span>
  </div>

</div>
"
