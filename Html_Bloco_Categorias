Html_Bloco_Categorias = 
/* --- 1. CAPTURA DOS DADOS --- */
VAR vCatprimeira    = SELECTEDVALUE('Base'[categoria_1], "-")
VAR vCatsegunda  = SELECTEDVALUE('Base'[categoria_2], "-")

/* --- 2. TRAVA DE SEGURANÇA --- */
VAR vTemFiltro = HASONEVALUE('Base'[Codigo])

/* --- 3. GERAÇÃO DO HTML --- */
VAR vConteudoHTML = 
    IF(
        NOT(vTemFiltro),
        
        /* CENÁRIO A: SEM FILTRO (MANTÉM OS CARDS VISÍVEIS) */
        "
        <div class='scroll-area'>
            <div class='info-grid'>
                
                <div class='info-item'>
                    <span class='label'>Primeira</span>
                    <span class='value'>-</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Segunda</span>
                    <span class='value'>-</span>
                </div>

            </div>
        </div>
        ",

        /* CENÁRIO B: DADOS REAIS */
        "
        <div class='scroll-area'>
            <div class='info-grid'>
                
                <div class='info-item'>
                    <span class='label'>Primeira</span>
                    <span class='value'>" & vCatprimeira & "</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Segunda</span>
                    <span class='value'>" & vCatsegunda & "</span>
                </div>

            </div>
        </div>
        "
    )

RETURN
"
<style>
    /* --- CONTAINER PRINCIPAL --- */
    .container-info { 
        font-family: 'Segoe UI', sans-serif; 
        font-size: 11px; 
        display: flex; 
        flex-direction: column; 
        background: #fff; 
        width: 100%;
        height: 100vh; 
        overflow: hidden; 
        padding: 2px;
        box-sizing: border-box; 
    }

    .titulo-fixo {
        font-size: 10px; 
        font-weight: bold; 
        color: #ffffff; 
        background-color: #0e5511;
        padding: 6px 6px; 
        margin-bottom: 4px; 
        text-transform: uppercase;
        border-radius: 2px 2px 0 0;
        flex-shrink: 0;  
    }

    .scroll-area { 
        overflow-y: auto; 
        background: #ffffff; 
        flex: 1 1 auto; 
        height: 100%; 
        padding: 2px;
        display: flex;
        flex-direction: column;
    }

    /* --- GRID DE CARDS --- */
    .info-grid {
        display: flex;
        flex-direction: column;
        gap: 8px; 
        height: 100%;
        flex: 1 1 auto;
    }

    .info-item {
        display: flex;
        flex-direction: column;
        padding: 8px 10px;
        background-color: #f9f9f9; 
        border: 1px solid #eee;
        border-radius: 4px;
        border-left: 4px solid #0e5511; 
        justify-content: flex-start;
        box-sizing: border-box;
        flex: 1 1 auto;
    }
    
    .info-item:hover {
        background-color: #fafbfe;
        border-color: #d6d9f5;
        border-left-color: #0e5511;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .label {
        font-size: 10px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .value {
        font-size: 12px;
        font-weight: 700;
        color: #333;
        word-break: break-word;
        line-height: 1.3;
    }

</style>

<div class='container-info'>
    <div class='titulo-fixo'>
        Categorias
    </div>
    " & vConteudoHTML & "
</div>
"
