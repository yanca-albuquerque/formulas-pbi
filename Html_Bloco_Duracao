Html_Bloco_Duracao = 
/* --- 1. CAPTURA DOS DADOS --- */
VAR vStatus = SELECTEDVALUE('Base'[status], "-")
VAR vTotalHoras = SELECTEDVALUE('Base'[total_horas], "-")
VAR vDataFimRaw = SELECTEDVALUE('Base'[data_fim])
VAR vDataFim = IF(ISBLANK(vDataFimRaw), "-", FORMAT(vDataFimRaw, "dd/MM/yyyy HH:mm"))
VAR vPausada = SELECTEDVALUE('Base'[pausada], "-")

VAR vTextoPausa = 
    IF(vPausada = TRUE() || vPausada = "1", "Sim", IF(vPausada = FALSE() || vPausada = "0", "Não", "-"))

/* --- COR DINÂMICA DO SLA (STATUS) --- */
VAR vCorStatus = 
    SWITCH(
        TRUE(),
        vStatus = "No Prazo" || vStatus = "Cumprido", "#28a745", /* Verde */
        vStatus = "Estourado" || vStatus = "Violado", "#dc3545", /* Vermelho */
        "#1d2ba7" /* Azul padrão caso esteja neutro ou sem filtro */
    )

/* --- 2. TRAVA DE SEGURANÇA --- */
VAR vTemFiltro = HASONEVALUE('Base'[codigo])

/* --- 3. GERAÇÃO DO HTML --- */
VAR vConteudoHTML = 
    IF(
        NOT(vTemFiltro),
        
        /* CENÁRIO A: SEM FILTRO (MANTÉM AS 4 COLUNAS VISÍVEIS) */
        "
        <div class='scroll-area'>
            <div class='info-grid'>
                
                <div class='info-item'>
                    <span class='label'>Status</span>
                    <span class='value'>-</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Total de Horas</span>
                    <span class='value'>-</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Data Fim</span>
                    <span class='value'>-</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Está em Pausa?</span>
                    <span class='value'>-</span>
                </div>

            </div>
        </div>
        ",

        /* CENÁRIO B: DADOS REAIS */
        "
        <div class='scroll-area'>
            <div class='info-grid'>
                
                <div class='info-item' style='border-left-color: " & vCorStatus & ";'>
                    <span class='label'>Status</span>
                    <span class='value' style='color: " & vCorStatus & ";'>" & vStatus & "</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Total de Horas</span>
                    <span class='value'>" & IF(vTotalHoras = "-", "-", vTotalHoras & "h") & "</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Data Fim</span>
                    <span class='value'>" & vDataFim & "</span>
                </div>

                <div class='info-item'>
                    <span class='label'>Está em Pausa?</span>
                    <span class='value'>" & vTextoPausa & "</span>
                </div>

            </div>
        </div>
        "
    )

RETURN
"
<style>
    /* --- ESTRUTURA GERAL --- */
    .container-info { 
        font-family: 'Segoe UI', sans-serif; 
        font-size: 11px; 
        display: flex; 
        flex-direction: column; 
        background: #fff; 
        width: 100%;
        height: 100vh;
        overflow: hidden; 
        padding: 2px;
        box-sizing: border-box; 
    }

    /* --- BARRA AZUL DE TÍTULO --- */
    .titulo-fixo {
        font-size: 10px; 
        font-weight: bold; 
        color: #ffffff; 
        background-color: #1ca175; 
        padding: 6px 6px; 
        margin-bottom: 4px; 
        text-transform: uppercase;
        border-radius: 2px 2px 0 0;
        flex-shrink: 0; 
    }

    /* --- ÁREA DE CONTEÚDO --- */
    .scroll-area { 
        overflow-y: auto; 
        background: #fff; 
        flex: 1 1 auto; 
        height: 100%;
        padding: 2px;
        display: flex;
        flex-direction: column;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr); 
        gap: 8px; 
        align-items: stretch;
        height: 100%;
        flex: 1 1 auto;
    }

    /* --- ESTILO DOS CARDS --- */
    .info-item {
        display: flex;
        flex-direction: column;
        padding: 8px 10px;
        background-color: #f9f9f9; 
        border: 1px solid #eee;
        border-radius: 4px;
        border-left: 4px solid #1ca175; 
        justify-content: flex-start;
        box-sizing: border-box;
        height: 100%;
    }

    .label {
        font-size: 10px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .value {
        font-size: 12px;
        font-weight: 500;
        color: #333;
        white-space: pre-wrap;
        word-break: break-word;
        line-height: 1.3;
    }

</style>

<div class='container-info'>
    <div class='titulo-fixo'>
        Duração
    </div>
    " & vConteudoHTML & "
</div>
"
