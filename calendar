# Calendário Dias Uteis
Calendario = 
VAR DataMinima = DATE(2026, 01, 01)
VAR DataMaxima = DATE(2027, 12, 31)
RETURN
ADDCOLUMNS (
    CALENDAR(DataMinima, DataMaxima),
    "Ano", YEAR ( [Date] ),
    "NumMes", MONTH([Date]),
    "Mes", FORMAT([Date], "MMMM", "pt-BR"),
    "DiaMes", FORMAT([Date], "DD/MM"),
    "AnoMes", FORMAT([Date], "YYYY-MM"),
    "Mes Ordenado", FORMAT([Date], "MM") & ". " & FORMAT([Date], "MMMM", "pt-BR"),
    "DiaUtil", 
    IF(
        WEEKDAY([Date], 2) >= 6, 
        0, 
        1
    )
)

# Calendário Dias úteis e sem Feriados:
Calendario = 
VAR DataMinima = DATE(2026, 01, 01)
VAR DataMaxima = DATE(2027, 12, 31)
RETURN
ADDCOLUMNS (
    CALENDAR(DataMinima, DataMaxima),
    "Ano", YEAR ( [Date] ),
    "NumMes", MONTH([Date]),
    "Mes", FORMAT([Date], "MMMM", "pt-BR"),
    "DiaMes", FORMAT([Date], "DD/MM"),
    "AnoMes", FORMAT([Date], "YYYY-MM"),
    "Mes Ordenado", FORMAT([Date], "MM") & ". " & FORMAT([Date], "MMMM", "pt-BR"),
    "DiaUtil", 
    VAR DataAtual = [Date]
    VAR Feriado = NOT ISBLANK(LOOKUPVALUE(Feriados[Data Feriado], Feriados[Data Feriado], DataAtual))
    RETURN
    IF(
        WEEKDAY(DataAtual, 2) >= 6 || Feriado, 
        0, 
        1
    )
)

