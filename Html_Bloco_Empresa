Html_Bloco_Empresa = 
/* --- 1. TRAVA DE SEGURANÇA ESTRITA --- */
VAR vTemUmUnicoChamado = HASONEVALUE('Base'[codigo]) || HASONEVALUE('Base'[id])

/* --- 2. CAPTURA DOS DADOS --- */
VAR vEmpresa      = SELECTEDVALUE('Base'[empresa], "-")
VAR vDepartamento = SELECTEDVALUE('Base'[departamento], "-")
VAR vContato      = SELECTEDVALUE('Base'[contato], "-")
VAR vDataEntrada  = IF(ISBLANK(SELECTEDVALUE('Base'[data_entrada])), "-", FORMAT(SELECTEDVALUE('Base'[data_entrada]), "dd/mm/yyyy"))
VAR vDataSaida    = IF(ISBLANK(SELECTEDVALUE('Base'[data_saida])), "-", FORMAT(SELECTEDVALUE('Base'[data_saida]), "dd/mm/yyyy"))

/* --- 3. GERAÇÃO DO HTML --- */
VAR vConteudoHTML = 
    IF(
        NOT(vTemUmUnicoChamado),
        
        /* CENÁRIO A: SEM FILTRO (MANTÉM AS COLUNAS PREENCHIDAS COM "-") */
        "
        <div class='header-table'>
            <span class='c-empresa'>EMPRESA</span>
            <span class='c-departamento'>DEPARTAMENTO</span>
            <span class='c-contato'>CONTATO</span>
            <span class='c-datae'>DATA ENTRADA</span>
            <span class='c-datas'>DATA SAÍDA</span>
        </div>
        <div class='scroll-area'>
            <div class='row-grid'>
                <span class='c-empresa text-bold'>-</span>
                <span class='c-departamento'>-</span>
                <span class='c-contato'>-</span>
                <span class='c-datae'>-</span>
                <span class='c-datas'>-</span>
            </div>
        </div>
        ",

        /* CENÁRIO B: DADOS REAIS */
        "
        <div class='header-table'>
            <span class='c-empresa'>EMPRESA</span>
            <span class='c-departamento'>DEPARTAMENTO</span>
            <span class='c-contato'>CONTATO</span>
            <span class='c-datae'>DATA ENTRADA</span>
            <span class='c-datas'>DATA SAÍDA</span>
        </div>
        <div class='scroll-area'>
            <div class='row-grid'>
                <span class='c-empresa text-bold'>" & vEmpresa & "</span>
                <span class='c-departamento'>" & vDepartamento & "</span>
                <span class='c-contato'>" & vContato & "</span>
                <span class='c-datae'>" & vDataEntrada & "</span>
                <span class='c-datas'>" & vDataSaida & "</span>
            </div>
        </div>
        "
    )

RETURN
"
<style>
    /* --- ESTRUTURA GERAL --- */
    .container-empresa { 
        font-family: 'Segoe UI', sans-serif; 
        font-size: 11px; 
        display: flex; 
        flex-direction: column; 
        background: #fff; 
        width: 100%;
        height: 100vh; 
        overflow: hidden; 
        box-sizing: border-box;
        padding: 2px;
    }

    /* --- CABEÇALHO DA TABELA --- */
    .header-table {
        display: flex; 
        align-items: center;
        background-color: #188144; 
        color: #ffffff;
        padding: 6px 8px; 
        font-weight: bold;
        border-radius: 2px;
        font-size: 10px; 
        text-transform: uppercase;
        flex-shrink: 0; 
    }

    /* --- ÁREA DE CONTEÚDO --- */
    .scroll-area { 
        overflow-y: auto; 
        background: #fff; 
        flex: 1 1 auto; 
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    /* --- SISTEMA DE COLUNAS --- */
    .c-empresa { width: 22%; word-break: break-word; padding-right: 6px; flex-shrink: 0; }
    .c-setor   { width: 20%; word-break: break-word; padding-right: 6px; flex-shrink: 0; }
    .c-contato { width: 30%; word-break: break-word; padding-right: 6px; flex-shrink: 0; }
    .c-datac   { width: 14%; word-break: break-word; padding-right: 6px; flex-shrink: 0; text-align: center; }
    .c-datas   { width: 14%; word-break: break-word; flex-shrink: 0; text-align: center; }

    .text-bold { font-weight: bold; color: #222; }

    .row-grid {
        display: flex; 
        align-items: center;
        padding: 8px;
        margin-top: 4px;
        background-color: #f9f9f9;
        border: 1px solid #eee;
        border-radius: 4px;
        border-left: 4px solid #188144;
        flex: 1 1 auto;
        box-sizing: border-box;
        height: 100%;
    }
</style>

<div class='container-empresa'>
    " & vConteudoHTML & "
</div>
"
